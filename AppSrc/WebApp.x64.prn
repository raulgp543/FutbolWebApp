38605>>>    Procedure SetActionButtons
38608>>>        tWebNavigateData NavigateData
38608>>>        tWebNavigateData NavigateData
38608>>>        Boolean bHasRecord
38608>>>        Handle hoDD
38608>>>
38608>>>        Get Server to hoDD
38609>>>        Get GetNavigateData to NavigateData
38610>>>        Get HasRecord of hoDD to bHasRecord
38611>>>
38611>>>        // let's hide all buttons and then Show the ones we want
38611>>>        WebSet pbRender of oEditBtn to False
38612>>>        WebSet pbRender of oSaveBtn to False
38613>>>        WebSet pbRender of oCancelChangesBtn to False
38614>>>        WebSet pbRender of oDeleteBtn to False
38615>>>
38615>>>        If (NavigateData.bReadOnly) Begin
38617>>>            WebSet pbRender of oEditBtn to True
38618>>>        End
38618>>>>
38618>>>        Else Begin
38619>>>            WebSet pbRender of oSaveBtn to True
38620>>>            WebSet pbRender of oCancelChangesBtn to True
38621>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38622>>>        End
38622>>>>
38622>>>    End_Procedure
38623>>>
38623>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38626>>>        // Close after save
38626>>>        Send NavigateClose Self
38627>>>    End_Procedure
38628>>>
38628>>>    // this will close the view after a delete
38628>>>    Procedure OnViewDeleted Handle hoDDO
38631>>>        Send NavigateClose Self
38632>>>    End_Procedure
