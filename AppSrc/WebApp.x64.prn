38610>>>                // If from parent, this is a constrained drill down.
38610>>>                Case Break
38611>>>
38611>>>            Case (NavigateData.eNavigateType = nfFromChild)
38614>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38614>>>                Case Break
38615>>>
38615>>>            Case Else // must be nfUndefined
38615>>>
38615>>>        Case End
38615>>>
38615>>>        Send SetActionButtons
38616>>>
38616>>>    End_Procedure
38617>>>
38617>>>End_Object 
