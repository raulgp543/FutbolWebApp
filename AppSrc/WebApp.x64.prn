38669>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38672>>>        Case Begin
38672>>>            Case (NavigateData.eNavigateType = nfFromMain)
38674>>>                // If from main, this is a propbably a main file Select to Zoom.
38674>>>                String sMsg
38674>>>    
38674>>>                Move (SFormat("From Main%1InvokingObject handle: %2%1Nombre: %3", Character(10), String(hoInvokingObject), String(Name(hoInvokingObject)))) to sMsg
38675>>>                Send ShowInfoBox sMsg
38676>>>                Case Break
38677>>>
38677>>>            Case (NavigateData.eNavigateType = nfFromParent)
38680>>>                // If from parent, this is a constrained drill down.
38680>>>                Case Break
38681>>>
38681>>>            Case (NavigateData.eNavigateType = nfFromChild)
38684>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38684>>>                Case Break
38685>>>
38685>>>            Case Else // must be nfUndefined
38685>>>
38685>>>        Case End
38685>>>
38685>>>        Send SetActionButtons
38686>>>
38686>>>    End_Procedure
38687>>>
38687>>>End_Object 
