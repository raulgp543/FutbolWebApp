37741>>>    Procedure SetActionButtons
37744>>>        tWebNavigateData NavigateData
37744>>>        tWebNavigateData NavigateData
37744>>>        Boolean bHasRecord
37744>>>        Handle hoDD
37744>>>
37744>>>        Get Server to hoDD
37745>>>        Get GetNavigateData to NavigateData
37746>>>        Get HasRecord of hoDD to bHasRecord
37747>>>
37747>>>        // let's hide all buttons and then Show the ones we want
37747>>>        WebSet pbRender of oEditBtn to False
37748>>>        WebSet pbRender of oSaveBtn to False
37749>>>        WebSet pbRender of oCancelChangesBtn to False
37750>>>        WebSet pbRender of oDeleteBtn to False
37751>>>
37751>>>        If (NavigateData.bReadOnly) Begin
37753>>>            WebSet pbRender of oEditBtn to True
37754>>>        End
37754>>>>
37754>>>        Else Begin
37755>>>            WebSet pbRender of oSaveBtn to True
37756>>>            WebSet pbRender of oCancelChangesBtn to True
37757>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37758>>>        End
37758>>>>
37758>>>    End_Procedure
