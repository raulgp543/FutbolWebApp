37843>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37846>>>        Case Begin
37846>>>            Case (NavigateData.eNavigateType = nfFromMain)
37848>>>                // If from main, this is a propbably a main file Select to Zoom.
37848>>>                Case Break
37849>>>
37849>>>            Case (NavigateData.eNavigateType = nfFromParent)
37852>>>                // If from parent, this is a constrained drill down.
37852>>>                Case Break
37853>>>
37853>>>            Case (NavigateData.eNavigateType = nfFromChild)
37856>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37856>>>                Case Break
37857>>>
37857>>>            Case Else // must be nfUndefined
37857>>>
37857>>>        Case End
37857>>>
37857>>>        Send SetActionButtons
37858>>>
37858>>>    End_Procedure
37859>>>
37859>>>End_Object 
