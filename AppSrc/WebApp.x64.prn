38511>>>        WebSet pbRender of oSaveBtn to False
38512>>>        WebSet pbRender of oCancelChangesBtn to False
38513>>>        WebSet pbRender of oDeleteBtn to False
38514>>>
38514>>>        If (NavigateData.bReadOnly) Begin
