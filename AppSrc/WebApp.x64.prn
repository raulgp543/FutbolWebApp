38541>>>        WebSet pbRender of oEditBtn to False
38542>>>        WebSet pbRender of oSaveBtn to False
38543>>>        WebSet pbRender of oCancelChangesBtn to False
38544>>>        WebSet pbRender of oDeleteBtn to False
38545>>>
38545>>>        If (NavigateData.bReadOnly) Begin
