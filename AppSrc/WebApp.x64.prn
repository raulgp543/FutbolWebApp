38660>>>                // If from main, this is a propbably a main file Select to Zoom.
38660>>>                Case Break
38661>>>
38661>>>            Case (NavigateData.eNavigateType = nfFromParent)
38664>>>                // If from parent, this is a constrained drill down.
38664>>>                Case Break
38665>>>
38665>>>            Case (NavigateData.eNavigateType = nfFromChild)
38668>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38668>>>                Case Break
38669>>>
38669>>>            Case Else // must be nfUndefined
38669>>>
38669>>>        Case End
38669>>>
38669>>>        Send SetActionButtons
38670>>>
38670>>>    End_Procedure
38671>>>
38671>>>End_Object 
