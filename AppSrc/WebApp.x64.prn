37879>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37882>>>        Case Begin
37882>>>            Case (NavigateData.eNavigateType = nfFromMain)
37884>>>                // If from main, this is a propbably a main file Select to Zoom.
37884>>>                Case Break
37885>>>
37885>>>            Case (NavigateData.eNavigateType = nfFromParent)
37888>>>                // If from parent, this is a constrained drill down.
37888>>>                Case Break
37889>>>
37889>>>            Case (NavigateData.eNavigateType = nfFromChild)
37892>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37892>>>                Case Break
37893>>>
37893>>>            Case Else // must be nfUndefined
37893>>>
37893>>>        Case End
37893>>>
37893>>>        Send SetActionButtons
37894>>>
37894>>>    End_Procedure
37895>>>
37895>>>End_Object 
