37686>>>                // If from main, this is a probably a main-file lookup from a Zoom
37686>>>                WebSet pbRender of oDetailButton to False
37687>>>                Case Break
37688>>>
37688>>>            Case Else // must be nfUndefined
37688>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37688>>>
37688>>>        Case End
