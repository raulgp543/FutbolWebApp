38573>>>    Procedure SetActionButtons
38576>>>        tWebNavigateData NavigateData
38576>>>        tWebNavigateData NavigateData
38576>>>        Boolean bHasRecord
38576>>>        Handle hoDD
38576>>>
38576>>>        Get Server to hoDD
38577>>>        Get GetNavigateData to NavigateData
38578>>>        Get HasRecord of hoDD to bHasRecord
38579>>>
38579>>>        // let's hide all buttons and then Show the ones we want
38579>>>        WebSet pbRender of oEditBtn to False
38580>>>        WebSet pbRender of oSaveBtn to False
38581>>>        WebSet pbRender of oCancelChangesBtn to False
38582>>>        WebSet pbRender of oDeleteBtn to False
38583>>>
38583>>>        If (NavigateData.bReadOnly) Begin
38585>>>            WebSet pbRender of oEditBtn to True
38586>>>        End
38586>>>>
38586>>>        Else Begin
38587>>>            WebSet pbRender of oSaveBtn to True
38588>>>            WebSet pbRender of oCancelChangesBtn to True
38589>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38590>>>        End
38590>>>>
38590>>>    End_Procedure
38591>>>
38591>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38594>>>        // Close after save
38594>>>        Send NavigateClose Self
38595>>>    End_Procedure
38596>>>
38596>>>    // this will close the view after a delete
38596>>>    Procedure OnViewDeleted Handle hoDDO
38599>>>        Send NavigateClose Self
38600>>>    End_Procedure
