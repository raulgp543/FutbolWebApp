38641>>>    Procedure SetActionButtons
38644>>>        tWebNavigateData NavigateData
38644>>>        tWebNavigateData NavigateData
38644>>>        Boolean bHasRecord
38644>>>        Handle hoDD
38644>>>
38644>>>        Get Server to hoDD
38645>>>        Get GetNavigateData to NavigateData
38646>>>        Get HasRecord of hoDD to bHasRecord
38647>>>
38647>>>        // let's hide all buttons and then Show the ones we want
38647>>>        WebSet pbRender of oEditBtn to False
38648>>>        WebSet pbRender of oSaveBtn to False
38649>>>        WebSet pbRender of oCancelChangesBtn to False
38650>>>        WebSet pbRender of oDeleteBtn to False
38651>>>
38651>>>        If (NavigateData.bReadOnly) Begin
38653>>>            WebSet pbRender of oEditBtn to True
38654>>>        End
38654>>>>
38654>>>        Else Begin
38655>>>            WebSet pbRender of oSaveBtn to True
38656>>>            WebSet pbRender of oCancelChangesBtn to True
38657>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38658>>>        End
38658>>>>
38658>>>    End_Procedure
38659>>>
38659>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38662>>>        // Close after save
38662>>>        Send NavigateClose Self
38663>>>    End_Procedure
38664>>>
38664>>>    // this will close the view after a delete
38664>>>    Procedure OnViewDeleted Handle hoDDO
38667>>>        Send NavigateClose Self
38668>>>    End_Procedure
