38627>>>    Procedure SetActionButtons
38630>>>        tWebNavigateData NavigateData
38630>>>        tWebNavigateData NavigateData
38630>>>        Boolean bHasRecord
38630>>>        Handle hoDD
38630>>>
38630>>>        Get Server to hoDD
38631>>>        Get GetNavigateData to NavigateData
38632>>>        Get HasRecord of hoDD to bHasRecord
38633>>>
38633>>>        // let's hide all buttons and then Show the ones we want
38633>>>        WebSet pbRender of oEditBtn to False
38634>>>        WebSet pbRender of oSaveBtn to False
38635>>>        WebSet pbRender of oCancelChangesBtn to False
38636>>>        WebSet pbRender of oDeleteBtn to False
38637>>>
38637>>>        If (NavigateData.bReadOnly) Begin
38639>>>            WebSet pbRender of oEditBtn to True
38640>>>        End
38640>>>>
38640>>>        Else Begin
38641>>>            WebSet pbRender of oSaveBtn to True
38642>>>            WebSet pbRender of oCancelChangesBtn to True
38643>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38644>>>        End
38644>>>>
38644>>>    End_Procedure
38645>>>
38645>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38648>>>        // Close after save
38648>>>        Send NavigateClose Self
38649>>>    End_Procedure
38650>>>
38650>>>    // this will close the view after a delete
38650>>>    Procedure OnViewDeleted Handle hoDDO
38653>>>        Send NavigateClose Self
38654>>>    End_Procedure
