38548>>>        End
38548>>>>
38548>>>        Else Begin
38549>>>            WebSet pbRender of oSaveBtn to True
38550>>>            WebSet pbRender of oCancelChangesBtn to True
38551>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38552>>>        End
38552>>>>
38552>>>    End_Procedure
