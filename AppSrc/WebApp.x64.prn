38592>>>    Procedure SetActionButtons
38595>>>        tWebNavigateData NavigateData
38595>>>        tWebNavigateData NavigateData
38595>>>        Boolean bHasRecord
38595>>>        Handle hoDD
38595>>>
38595>>>        Get Server to hoDD
38596>>>        Get GetNavigateData to NavigateData
38597>>>        Get HasRecord of hoDD to bHasRecord
38598>>>
38598>>>        // let's hide all buttons and then Show the ones we want
38598>>>        WebSet pbRender of oEditBtn to False
38599>>>        WebSet pbRender of oSaveBtn to False
38600>>>        WebSet pbRender of oCancelChangesBtn to False
38601>>>        WebSet pbRender of oDeleteBtn to False
38602>>>
38602>>>        If (NavigateData.bReadOnly) Begin
38604>>>            WebSet pbRender of oEditBtn to True
38605>>>        End
38605>>>>
38605>>>        Else Begin
38606>>>            WebSet pbRender of oSaveBtn to True
38607>>>            WebSet pbRender of oCancelChangesBtn to True
38608>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38609>>>        End
38609>>>>
38609>>>    End_Procedure
38610>>>
