38643>>>            Case (NavigateData.eNavigateType = nfFromParent)
38646>>>                // If from parent, this is a constrained drill down.
38646>>>                Case Break
38647>>>
38647>>>            Case (NavigateData.eNavigateType = nfFromChild)
38650>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38650>>>                Case Break
38651>>>
38651>>>            Case Else // must be nfUndefined
38651>>>
38651>>>        Case End
38651>>>
38651>>>        Send SetActionButtons
38652>>>
38652>>>    End_Procedure
38653>>>
38653>>>End_Object 
