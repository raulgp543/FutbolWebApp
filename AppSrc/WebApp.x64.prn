38609>>>    Procedure SetActionButtons
38612>>>        tWebNavigateData NavigateData
38612>>>        tWebNavigateData NavigateData
38612>>>        Boolean bHasRecord
38612>>>        Handle hoDD
38612>>>
38612>>>        Get Server to hoDD
38613>>>        Get GetNavigateData to NavigateData
38614>>>        Get HasRecord of hoDD to bHasRecord
38615>>>
38615>>>        // let's hide all buttons and then Show the ones we want
38615>>>        WebSet pbRender of oEditBtn to False
38616>>>        WebSet pbRender of oSaveBtn to False
38617>>>        WebSet pbRender of oCancelChangesBtn to False
38618>>>        WebSet pbRender of oDeleteBtn to False
38619>>>
38619>>>        If (NavigateData.bReadOnly) Begin
38621>>>            WebSet pbRender of oEditBtn to True
38622>>>        End
38622>>>>
38622>>>        Else Begin
38623>>>            WebSet pbRender of oSaveBtn to True
38624>>>            WebSet pbRender of oCancelChangesBtn to True
38625>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38626>>>        End
38626>>>>
38626>>>    End_Procedure
38627>>>
