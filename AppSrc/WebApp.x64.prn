37727>>>        tWebNavigateData NavigateData
37727>>>        tWebNavigateData NavigateData
37727>>>        Boolean bHasRecord
37727>>>        Handle hoDD
37727>>>
37727>>>        Get Server to hoDD
37728>>>        Get GetNavigateData to NavigateData
37729>>>        Get HasRecord of hoDD to bHasRecord
37730>>>
37730>>>        // let's hide all buttons and then Show the ones we want
37730>>>        WebSet pbRender of oEditBtn to False
37731>>>        WebSet pbRender of oSaveBtn to False
37732>>>        WebSet pbRender of oCancelChangesBtn to False
37733>>>        WebSet pbRender of oDeleteBtn to False
37734>>>
37734>>>        If (NavigateData.bReadOnly) Begin
37736>>>            WebSet pbRender of oEditBtn to True
37737>>>        End
37737>>>>
37737>>>        Else Begin
37738>>>            WebSet pbRender of oSaveBtn to True
37739>>>            WebSet pbRender of oCancelChangesBtn to True
37740>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37741>>>        End
37741>>>>
37741>>>    End_Procedure
