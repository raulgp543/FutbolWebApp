37799>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37799>>>                Case Break
37800>>>
37800>>>            Case Else // must be nfUndefined
37800>>>
37800>>>        Case End
37800>>>
37800>>>        Send SetActionButtons
