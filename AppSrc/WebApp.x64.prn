36564>>>>>>>    //
36564>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36564>>>>>>>    //
36564>>>>>>>    //  Params:
36564>>>>>>>    //      dtTime  Time to convert
36564>>>>>>>    //  Returns:
36564>>>>>>>    //      String with "HH:MM:SS" format
36564>>>>>>>    //
36564>>>>>>>    Function TimeToString DateTime dtTime Returns String
36566>>>>>>>        String sHours sMinutes sSeconds
36566>>>>>>>        
36566>>>>>>>        //  Extract parts
36566>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36567>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36568>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36569>>>>>>>        
36569>>>>>>>        //  Fill out with 0
36569>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36572>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36575>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36578>>>>>>>        
36578>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36579>>>>>>>    End_Function
36580>>>>>>>    
36580>>>>>>>    //
36580>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36580>>>>>>>    //
36580>>>>>>>    //  Params:
36580>>>>>>>    //      dtTime  Datetime variable to add time to
36580>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36580>>>>>>>    //  Returns:
36580>>>>>>>    //      dtDateTime with the loaded time
36580>>>>>>>    //
36580>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36582>>>>>>>        String sHours sMinutes sSeconds
36582>>>>>>>        
36582>>>>>>>        //  Extract parts
36582>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36583>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36584>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36585>>>>>>>        
36585>>>>>>>        //  Set to DateTime
36585>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36586>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36587>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36588>>>>>>>        
36588>>>>>>>        Function_Return dtTime
36589>>>>>>>    End_Function
