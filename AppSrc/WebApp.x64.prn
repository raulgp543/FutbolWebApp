37847>>>    Procedure SetActionButtons
37850>>>        tWebNavigateData NavigateData
37850>>>        tWebNavigateData NavigateData
37850>>>        Boolean bHasRecord
37850>>>        Handle hoDD
37850>>>
37850>>>        Get Server to hoDD
37851>>>        Get GetNavigateData to NavigateData
37852>>>        Get HasRecord of hoDD to bHasRecord
37853>>>
37853>>>        // let's hide all buttons and then Show the ones we want
37853>>>        WebSet pbRender of oEditBtn to False
37854>>>        WebSet pbRender of oSaveBtn to False
37855>>>        WebSet pbRender of oCancelChangesBtn to False
37856>>>        WebSet pbRender of oDeleteBtn to False
37857>>>
37857>>>        If (NavigateData.bReadOnly) Begin
37859>>>            WebSet pbRender of oEditBtn to True
37860>>>        End
37860>>>>
37860>>>        Else Begin
37861>>>            WebSet pbRender of oSaveBtn to True
37862>>>            WebSet pbRender of oCancelChangesBtn to True
37863>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37864>>>        End
37864>>>>
37864>>>    End_Procedure
37865>>>
