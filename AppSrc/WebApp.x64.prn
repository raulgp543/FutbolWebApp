37761>>>        tWebNavigateData NavigateData
37761>>>        tWebNavigateData NavigateData
37761>>>        Boolean bHasRecord
37761>>>        Handle hoDD
37761>>>
37761>>>        Get Server to hoDD
37762>>>        Get GetNavigateData to NavigateData
37763>>>        Get HasRecord of hoDD to bHasRecord
37764>>>
37764>>>        // let's hide all buttons and then Show the ones we want
37764>>>        WebSet pbRender of oEditBtn to False
37765>>>        WebSet pbRender of oSaveBtn to False
37766>>>        WebSet pbRender of oCancelChangesBtn to False
37767>>>        WebSet pbRender of oDeleteBtn to False
37768>>>
37768>>>        If (NavigateData.bReadOnly) Begin
37770>>>            WebSet pbRender of oEditBtn to True
37771>>>        End
37771>>>>
37771>>>        Else Begin
37772>>>            WebSet pbRender of oSaveBtn to True
37773>>>            WebSet pbRender of oCancelChangesBtn to True
37774>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37775>>>        End
37775>>>>
37775>>>    End_Procedure
