37780>>>        tWebNavigateData NavigateData
37780>>>        tWebNavigateData NavigateData
37780>>>        Boolean bHasRecord
37780>>>        Handle hoDD
37780>>>
37780>>>        Get Server to hoDD
37781>>>        Get GetNavigateData to NavigateData
37782>>>        Get HasRecord of hoDD to bHasRecord
37783>>>
37783>>>        // let's hide all buttons and then Show the ones we want
37783>>>        WebSet pbRender of oEditBtn to False
37784>>>        WebSet pbRender of oSaveBtn to False
37785>>>        WebSet pbRender of oCancelChangesBtn to False
37786>>>        WebSet pbRender of oDeleteBtn to False
37787>>>
37787>>>        If (NavigateData.bReadOnly) Begin
37789>>>            WebSet pbRender of oEditBtn to True
37790>>>        End
37790>>>>
37790>>>        Else Begin
37791>>>            WebSet pbRender of oSaveBtn to True
37792>>>            WebSet pbRender of oCancelChangesBtn to True
37793>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37794>>>        End
37794>>>>
37794>>>    End_Procedure
