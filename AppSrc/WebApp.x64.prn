38638>>>                Case Break
38639>>>
38639>>>            Case (NavigateData.eNavigateType = nfFromParent)
38642>>>                // If from parent, this is a constrained drill down.
38642>>>                Case Break
38643>>>
38643>>>            Case (NavigateData.eNavigateType = nfFromChild)
38646>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38646>>>                Case Break
38647>>>
38647>>>            Case Else // must be nfUndefined
38647>>>
38647>>>        Case End
38647>>>
38647>>>        Send SetActionButtons
38648>>>
38648>>>    End_Procedure
38649>>>
38649>>>End_Object 
