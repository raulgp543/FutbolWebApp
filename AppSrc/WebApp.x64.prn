37775>>>
37775>>>            Case (NavigateData.eNavigateType = nfFromParent)
37778>>>                // If from parent, this is a constrained drill down.
37778>>>                Case Break
37779>>>
37779>>>            Case (NavigateData.eNavigateType = nfFromChild)
37782>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37782>>>                Case Break
37783>>>
37783>>>            Case Else // must be nfUndefined
37783>>>
37783>>>        Case End
37783>>>
37783>>>        Send SetActionButtons
37784>>>
37784>>>    End_Procedure
37785>>>
37785>>>End_Object 
