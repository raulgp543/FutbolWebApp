37878>>>        Case Begin
37878>>>            Case (NavigateData.eNavigateType = nfFromMain)
37880>>>                // If from main, this is a propbably a main file Select to Zoom.
37880>>>                Case Break
37881>>>
37881>>>            Case (NavigateData.eNavigateType = nfFromParent)
37884>>>                // If from parent, this is a constrained drill down.
37884>>>                Case Break
37885>>>
37885>>>            Case (NavigateData.eNavigateType = nfFromChild)
37888>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37888>>>                Case Break
37889>>>
37889>>>            Case Else // must be nfUndefined
37889>>>
37889>>>        Case End
37889>>>
37889>>>        Send SetActionButtons
37890>>>
37890>>>    End_Procedure
37891>>>
37891>>>End_Object 
